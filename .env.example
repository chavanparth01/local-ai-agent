# ==========================================
# Primary LLM Configuration: Google Gemini (Recommended)
# ==========================================
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Google Gemini provides high throughput (15 RPM, 250K TPM, 500 RPD) via OpenAI compatibility.
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
API_KEY=your_gemini_api_key
MODEL=gemini-3.5-flash-lite

# Alternative: Groq Cloud Configuration
# BASE_URL=https://api.groq.com/openai/v1
# API_KEY=your_groq_api_key
# MODEL=llama-3.1-8b-instant

# Alternative: Local Ollama Configuration
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL=qwen3:4b

# ==========================================
# Context Management & Token Budgets
# ==========================================
# Maximum request tokens (system prompt + history + tools + completion).
# Default: 64000 for Gemini (250K TPM), 12000 for Groq Llama 8B, 16000 for local Ollama.
MAX_REQUEST_TOKENS=64000

# Reserved completion tokens for model response generation.
# Default: 4096 for Gemini, 2048 for Groq/Ollama.
MAX_COMPLETION_TOKENS=4096

# ==========================================
# External Tools Configuration
# ==========================================
# Weather API key (from https://www.weatherapi.com/)
WEATHER_API_KEY=your_weatherapi_key

# Web Search API key (from https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key

# Debug logging and execution diagnostics (true/false)
DEBUG=false
