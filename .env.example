# ==========================================
# Primary LLM Configuration: Groq Cloud (Recommended)
# ==========================================
# Sign up at https://console.groq.com and generate an API key
BASE_URL=https://api.groq.com/openai/v1
API_KEY=your_groq_api_key
MODEL=openai/gpt-oss-120b

# Alternative: Local Ollama Configuration (Switch by uncommenting below)
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL=qwen3:4b

# ==========================================
# Token-Aware Context Management
# ==========================================
# Groq Free Tier has an 8,000 TPM limit for openai/gpt-oss-120b.
# MAX_REQUEST_TOKENS caps total request tokens (system prompt + history + tools + completion).
# Default: 6000 for Groq Cloud (25% safety margin below 8000), 16000 for local Ollama.
MAX_REQUEST_TOKENS=6000

# Reserved completion tokens for model response generation.
# Groq charges max_tokens against TPM limit. Default: 1500 for Groq Cloud, 2048 for local Ollama.
MAX_COMPLETION_TOKENS=1500

# ==========================================
# External Tools Configuration
# ==========================================
# Weather API key (from https://www.weatherapi.com/)
WEATHER_API_KEY=your_weatherapi_key

# Web Search API key (from https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key

# Debug logging and execution diagnostics (true/false)
DEBUG=false
